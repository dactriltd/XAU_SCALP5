# .env.example — TEMPLATE (copy thành .env rồi điền giá trị; .env KHÔNG bao giờ commit)

# XAU_Quant_System Environment Configuration — SANDBOX (Data-Verified 2026-09-25)
# Based on quantitative analysis of 11,608 M1 bars, 4,652 M5 bars, 2,182 swings, 513 trades

# 1. META API (Get from https://app.metaapi.cloud)
METAAPI_TOKEN=<điền MetaApi cloud JWT token>
ACCOUNT_ID=<điền MetaApi trading account uuid>

# 2. TRADING SYMBOLS
ACTIVE_SYMBOLS=XAUUSDm

# 3. TELEGRAM
TELEGRAM_BOT_TOKEN=<điền Telegram bot token>
TELEGRAM_CHAT_ID=<điền chat id>
ENABLE_TELEGRAM_ALERTS=true

# 4. DATABASE
DB_PATH=data/xau_quant.db



# ─────────────────────────────────────────────────────────────────────────────
# RISK (DIR-003 MANDATORY)
# ─────────────────────────────────────────────────────────────────────────────
RISK_PER_TRADE_PCT=0.4
MAX_LOT_PER_TRADE=0.02    # cap CHI khi SIZING_MODE=risk (target mode dùng TARGET_MAX_LOT)

# TARGET-CAPTURE SIZING — muc tieu $300/goi (2026-10-02, user chap nhan risk mat het, "khong ban lui")
# lot = 300 / (100 × ATR_M15 × 2.0) → P&L khi TP dat (TP = 2.0×ATR_M15 cua WAVE_ASB) ≈ $300.
# Vol-gate: ATR_M15 < 4.0 → bo lenh (ma dieu kien). Cap 0.25 lot (leverage 1:2000).
# STATUS 2026-10-02: DOng — tai khoản trial bi STOP_OUT (equity -$4.3) do 1 lenh
# target 0.19 lot tren equity $52.39. Chuyen ve RISK mode; target chuan bi lai
# khi (a) re-credit trial hoac (b) von that >= $3.000 (1 lenh target ~10% tai khoan).
SIZING_MODE=risk
TARGET_DAILY_USD=300
TARGET_MAX_LOT=0.03
TARGET_CAPTURE_ATRS=2.0
TARGET_VOL_GATE_ATR=4.0
MIN_LOT=0.02
LOT_STEP=0.01
MAX_OPEN_POSITIONS=3
TOTAL_RISK_CAP_MULT=1.5
MAX_DAILY_DRAWDOWN_PCT=1.0   
MAX_TOTAL_DRAWDOWN_PCT=1.0

# ─────────────────────────────────────────────────────────────────────────────
# EXNESS SESSION (Guards)
# ─────────────────────────────────────────────────────────────────────────────
ROLLOVER_START_UTC=21:45
ROLLOVER_END_UTC=00:30
LUNCH_PAUSE_ENABLED=true
LUNCH_PAUSE_START_HOUR=4
LUNCH_PAUSE_END_HOUR=5
